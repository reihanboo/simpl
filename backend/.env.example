PORT=8080
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simpl_db
DB_PORT=5432
JWT_SECRET=supersecretjwtkey_change_me_in_production
RESEND_API_KEY=your_resend_api_key_here

# DeepSeek AI assistant. DEEPSEEK_API is accepted as an alias for DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Dedicated read-only role for AI database access (see scripts/ai_readonly_role.sql).
# When AI_DB_USER is empty, the AI tools reuse the primary DB credentials above.
AI_DB_USER=simpl_ai_readonly
AI_DB_PASSWORD=choose_a_strong_password